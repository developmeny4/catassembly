// the script, when imported properly should log these :

// greetings
// var is currently at 4
// var is currently at 5
// var is currently at 6
// var2 is currently at -5
// var2 is currently at 1
// var2 is currently at 7
// ...

event WhenWebsiteLoaded(): {
	log("greetings");
	set(var, 3);
	repeat var {
		add(var, 1);
		log("var is currently at {var}");
	}
	
	set(var2, -5);

	loop {
		wait(1);
		log("var2 is currently at {var2}");
		add(var2, var);
	}
	err("loop ended (THIS SHOULD NOT HAPPEN)");
}
